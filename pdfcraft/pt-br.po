msgstr "Este documento não possui figuras marcadas."

msgid "This document has no text to make bookmarks from."
msgstr ""

msgid "This document has no XMP metadata."
msgstr "Este documento não tem metadados XMP."

msgid "This document has no {kind} to change"
msgstr "Este documento não tem {kind} para alterar"

msgid "This document has not been modified since this signature was applied."
msgstr "Este documento não foi modificado desde que esta assinatura foi aplicada."

