msgstr "Leikkuulaatikko pidetään paikallaan, joten painettu sivu leikataan samoin."

msgid "The value is shown as typed."
msgstr "Arvo näytetään kirjoitetussa muodossa."

msgid "The value {value} of {key} in {type} is deprecated since PDF {since}"
msgstr "Tyypin {type} avaimen {key} arvo {value} on vanhentunut PDF {since}:stä lähtien"

msgid "The value {value} of {key} in {type} is from PDF {since}, later than the file's PDF {version}"
