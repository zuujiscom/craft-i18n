msgid "A colour on this page couldn't be computed and is shown in a fallback colour."
msgstr "Vienu krāsu šajā lapā neizdevās aprēķināt, tāpēc tā ir parādīta aizstājējkrāsā."

msgid "A colour operator's operands don't match its colour space"
msgstr "Krāsas operatora operandi neatbilst tā krāsu telpai"

msgid "A colour space is nested too deeply for the spaces under it to be checked"
msgstr "Krāsu telpa ir ligzdota pārāk dziļi, lai pārbaudītu zem tās esošās telpas"

msgid "A colour space is nested too deeply to convert"
msgstr "Krāsu telpa ir ligzdota pārāk dziļi, lai to pārvērstu"

msgid "A colour space's ICC profile can't be used to convert its colour"
msgstr "Krāsu telpas ICC profilu nevar izmantot krāsas pārvēršanai"

msgid "a column is too narrow: make the area wider, give the column more of it, or use fewer columns or less column spacing"
msgstr "kolonna ir pārāk šaura: palieliniet apgabalu, atvēliet kolonnai vairāk vietas vai izmantojiet mazāk kolonnu vai mazāku atstatumu starp tām"

msgid "A content stream can't be read, so its colour can't be converted"
msgstr "Satura straumi nevar nolasīt, tāpēc tās krāsu nevar pārvērst"

msgid "A content stream is drawn with different resources in different places, so its colour can't be converted"
msgstr "Satura straume dažādās vietās tiek attēlota ar atšķirīgiem resursiem, tāpēc tās krāsu nevar pārvērst"

msgid "A cover on the scanner is open."
msgstr "Skenerim ir atvērts vāks."

msgid "A diagonal CONFIDENTIAL watermark on every page."
msgstr "Diagonāla CONFIDENTIAL ūdenszīme katrā lapā."

msgid "a document must keep at least one page"
msgstr "dokumentā jāpaliek vismaz vienai lapai"

msgid "A document needs at least one page: copy instead"
msgstr "Dokumentam nepieciešama vismaz viena lapa: tā vietā kopējiet"

msgid "A document timestamp covers the whole file and is no one's signature, so it can't be removed on its own."
msgstr "Dokumenta laikspiedols aptver visu failu un nav neviena paraksts, tāpēc to nevar noņemt atsevišķi."

msgid "a field named {name} already exists"
msgstr "lauks ar nosaukumu {name} jau pastāv"

msgid "A folder is asked for when a multiple-file run starts"
msgstr "Mape tiek prasīta, sākot vairāku failu apstrādi"

msgid "A font isn't embedded"
msgstr "Fonts nav iegults"

msgid "A form field has additional actions"
msgstr "Veidlapas laukam ir papildu darbības"

msgid "A form XObject is a transparency group"
msgstr "Veidlapas XObject ir caurspīdīguma grupa"

msgid "A form XObject refers to a page of another file (reference XObject)"
msgstr "Veidlapas XObject atsaucas uz cita faila lapu (atsauces XObject)"

msgid "A form XObject with marked content (MCIDs) is drawn {n} times"
msgstr "Veidlapas XObject ar marķētu saturu (MCID) ir attēlots {n} reizes"

msgid "A graphics state sets an opacity below 1"
msgstr "Grafikas stāvoklis iestata necaurredzamību, kas mazāka par 1"

