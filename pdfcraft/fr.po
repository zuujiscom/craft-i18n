msgstr "Un document doit contenir au moins une page : copiez plutôt"

msgid "A document timestamp covers the whole file and is no one's signature, so it can't be removed on its own."
msgstr "Un horodatage du document couvre tout le fichier et n'est la signature de personne : il ne peut donc pas être supprimé seul."

msgid "a field named {name} already exists"
msgstr "un champ nommé {name} existe déjà"

