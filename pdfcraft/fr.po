msgstr "Une image en niveaux de gris est dessinée à {} ppp"

msgid "a header cell with no Scope, in a table that doesn't use Headers"
msgstr "une cellule d'en-tête sans portée, dans un tableau qui n'utilise pas d'en-têtes"

msgid "A JPEG picture in CMYK can't be converted yet"
msgstr "Une image JPEG en CMJN ne peut pas encore être convertie"

msgid "A line has width 0, the thinnest the printer can draw"
msgstr "Une ligne a une largeur de 0, la plus fine que l'imprimante puisse dessiner"

