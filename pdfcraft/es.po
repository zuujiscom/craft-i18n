msgstr "el motor tesseract no está disponible en la versión web"

msgid "the tesseract program was not found (install it, or add it to the PATH)"
msgstr "no se encontró el programa tesseract (instálelo o añádalo al PATH)"

msgid "The tesseract program, run as an external process"
msgstr "El programa tesseract, ejecutado como proceso externo"

msgid "The text is the same"
msgstr "El texto es el mismo"

