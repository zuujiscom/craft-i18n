msgstr "un documento debe conservar al menos una página"

msgid "A document needs at least one page: copy instead"
msgstr "Un documento necesita al menos una página: copia en su lugar"

msgid "A document timestamp covers the whole file and is no one's signature, so it can't be removed on its own."
msgstr "Una marca de tiempo del documento abarca todo el archivo y no es la firma de nadie, así que no se puede quitar por sí sola."

msgid "a field named {name} already exists"
msgstr "ya existe un campo llamado {name}"

